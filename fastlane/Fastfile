# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:mac)

def update_android_version(new_version)
	path = "../android/build.gradle"
    regex = /versionName: ".*"/
    result_value = "versionName: \"#{new_version}\""

    update_file(path, regex, result_value)
end

def update_ios_version(new_version)
	path = "../QonversionSandwich.podspec"
    regex = /s.version      = '.*'/
    result_value = "s.version      = '#{new_version}'"

    update_file(path, regex, result_value)

    # README integration snippets carry the sandwich version — keep them at the released one.
    update_file_strict("../README.md", /pod 'QonversionSandwich', '.*'/, "pod 'QonversionSandwich', '#{new_version}'")
    update_file_strict("../README.md", /s.dependency "QonversionSandwich", ".*"/, "s.dependency \"QonversionSandwich\", \"#{new_version}\"")
    update_file_strict("../README.md", /sandwich-sdk.git", exact: ".*"\)/, "sandwich-sdk.git\", exact: \"#{new_version}\")")
end

# The Qonversion iOS SDK pin lives in two manifests (podspec + Package.swift); they must always match.
def update_qonversion_dependency(new_version)
    UI.user_error!("Pass version:x.y.z") unless new_version.to_s.match?(/\A\d+\.\d+\.\d+\z/)

    update_file_strict("../QonversionSandwich.podspec", /s.dependency "Qonversion", ".*"/, "s.dependency \"Qonversion\", \"#{new_version}\"")
    update_file_strict("../Package.swift", /qonversion-ios-sdk.git", exact: ".*"\)/, "qonversion-ios-sdk.git\", exact: \"#{new_version}\")")
end

def update_file(path, regex, result_value)
	file = File.read(path)
    new_content = file.gsub(regex, result_value)
    File.open(path, 'w') { |line| line.puts new_content }
end

# Like update_file, but fails loudly unless the pattern matches exactly once —
# a silent no-op here would let the two dependency pins drift apart.
def update_file_strict(path, regex, result_value)
    file = File.read(path)
    matches = file.scan(regex).length
    UI.user_error!("#{path}: expected exactly one match for #{regex.inspect}, found #{matches}") unless matches == 1
    File.write(path, file.sub(regex, result_value))
end

def get_tag
  tag = last_git_tag()
  result_tag = tag.scan(%r{\d{1,2}.\d{1,2}.\d{1,3}}).first
  return result_tag
end

def calculate_minor_version(tag)
  major, minor, patch = parse_versions(tag)
  new_minor_version = minor.to_i.next.to_s
  new_version = major + "." + new_minor_version + "." + "0"
  return new_version
end

def calculate_patch_version(tag)
  major, minor, patch = parse_versions(tag)
  new_patch_version = patch.to_i.next.to_s
  new_version = major + "." + minor + "." + new_patch_version

  return new_version
end

def push_tag(tag)
  system("git checkout develop")
  system("git pull origin develop")
  system("git config --global user.email \"action@github.com\"")
  system("git config --global user.name \"GitHub Action\"")
  add_git_tag(tag: tag)
  push_git_tags(tag: tag)
end

def parse_versions(tag)
  split_version_array = tag.split(".", 3)

  if split_version_array.length == 3
    major = split_version_array[0]
    minor = split_version_array[1]
    patch = split_version_array[2]

    return major, minor, patch
  end
end

platform :mac do
  lane :bump do |options|
  	new_version = options[:version]

	update_android_version(new_version)
	update_ios_version(new_version)
  end

  # Bumps the Qonversion iOS SDK pin in both distribution manifests (podspec + Package.swift)
  # so CocoaPods and SPM consumers always get the same native SDK version.
  lane :upgrade_qonversion do |options|
    update_qonversion_dependency(options[:version])
  end

  lane :patch do
    tag = get_tag
    new_version = calculate_patch_version(tag)
    new_tag = "prerelease/" + new_version
    push_tag(new_tag)
  end

  lane :minor do
    tag = get_tag
    new_version = calculate_minor_version(tag)
    new_tag = "prerelease/" + new_version
    push_tag(new_tag)
  end
end